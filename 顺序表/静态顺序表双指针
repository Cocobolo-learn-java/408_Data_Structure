#include  <iostream>
using namespace std;
#define MAXSIZE 100
class SeqList {
public:
	int length;
	int data[MAXSIZE];    //ElemType data[MAXSIZE]; 
};






//已知线性表 (a1, a2, ..., an) 按顺序结构存储且每个元素为不相等的整数，
//设计把所有奇数移动到所有偶数前边的算法。
//例如，A = (1, 2, 3, 4, 5, 6, 7)，移动后变为 A = (1, 7, 3, 5, 4, 6, 2)
//（要求时间最少，辅助空间最少）。


//解决思路：快排思想

void oddEven(SeqList& list)
{
	int right = list.length-1;
	int left = 0;
	ElemType temp = list.data[left];
	while(left < right)
	{
		while(left < right && list.data[right] %2 == 0)
		{
			right--;
		}
		list.data[left] = list.data[right];
		while(left < right && list.data[left] %2 != 0)
		{
			left++;
		}
		list.data[right] = list.data[left];
	}
	list.data[left] = temp;



}





